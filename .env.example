# Environment Configuration for 2D Multiplayer Shooter

# Server Ports & Host
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database URL for MariaDB / MySQL
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="mysql://root:password123@localhost:3306/openworld_game"

# JWT Authentication Secret
JWT_SECRET="super-tactical-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

